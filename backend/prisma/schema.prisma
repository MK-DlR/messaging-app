generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @db.VarChar(32)
  usernameNormalized String    @unique @db.VarChar(32)
  password           String
  displayName        String?   @db.VarChar(64)
  icon               String    @default("default-user.png")
  profileInfo        String?   @db.VarChar(200)
  lastSeen           DateTime? @default(now())
  messages           Message[]
  channels           Channel[]
  createdChannels    Channel[] @relation("ChannelCreator")

  @@map("users")
}

model Message {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channels  Channel  @relation(fields: [channelId], references: [id])
  channelId Int
  userId    Int
  users     User     @relation(fields: [userId], references: [id])

  @@map("messages")
}

model Channel {
  id           Int       @id @default(autoincrement())
  name         String?   @db.VarChar(100)
  isCustomName Boolean   @default(false)
  icon         String    @default("default-channel.png")
  channelInfo  String?   @db.VarChar(200)
  createdAt    DateTime  @default(now())
  creatorId    Int?
  creator      User?     @relation("ChannelCreator", fields: [creatorId], references: [id])
  isGroup      Boolean   @default(false)
  isDefault    Boolean   @default(false)
  users        User[]
  messages     Message[]

  @@map("channels")
}
